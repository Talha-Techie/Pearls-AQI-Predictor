# Environment
.env
.venv/

# Python
__pycache__/
*.py[cod]

# Generated datasets
data/raw/*.parquet
data/historical/*.parquet
data/processed/*.parquet

# Preserve folders
!data/raw/.gitkeep
!data/historical/.gitkeep
!data/processed/.gitkeep

# Local model artifacts
artifacts/models/*.joblib

# Keep model directory
!artifacts/models/.gitkeep